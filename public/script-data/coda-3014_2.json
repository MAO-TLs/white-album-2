{"route":"coda","routeLabel":"Coda","scriptId":"3014_2","lineCount":16,"lines":[{"ref":"wa2:coda:3014_2:1","line":1,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「かずさ…時間」","english":"“Kazusa… It’s time.”"},{"ref":"wa2:coda:3014_2:2","line":2,"speakerJa":"かずさ","speakerEn":"Kazusa","japanese":"「ん…」","english":"“Mm…”"},{"ref":"wa2:coda:3014_2:3","line":3,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「どう？　緊張してる？」","english":"“How do you feel? Nervous?”"},{"ref":"wa2:coda:3014_2:4","line":4,"speakerJa":"かずさ","speakerEn":"Kazusa","japanese":"「まさか。\nいつもとおんなじだ」","english":"“Not a chance. Same as always.”"},{"ref":"wa2:coda:3014_2:5","line":5,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「そう…」","english":"“I see…”"},{"ref":"wa2:coda:3014_2:6","line":6,"speakerJa":"かずさ","speakerEn":"Kazusa","japanese":"「…いや、少しだけ違うな。\n失敗するイメージがまるで湧いてこない」","english":"“…No, a little different. I can’t picture myself failing at all.”"},{"ref":"wa2:coda:3014_2:7","line":7,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「………」","english":"“………”"},{"ref":"wa2:coda:3014_2:8","line":8,"speakerJa":"かずさ","speakerEn":"Kazusa","japanese":"「今日で、あんたのこと超えちゃうかもね」","english":"“Maybe today’s the day I surpass you.”"},{"ref":"wa2:coda:3014_2:9","line":9,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「それはわたしとしては大歓迎」","english":"“Nothing would please me more.”"},{"ref":"wa2:coda:3014_2:10","line":10,"speakerJa":"かずさ","speakerEn":"Kazusa","japanese":"「…なんてのは冗談だけど、\nそのくらい落ち着いてる」","english":"“…I’m joking. But that’s how calm I feel.”"},{"ref":"wa2:coda:3014_2:11","line":11,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「なら、そのまま最後まで駆け抜けなさい。\n途中で雑念に囚われたりしないようにね」","english":"“Then carry that feeling all the way to the end. Don’t let any stray thoughts distract you midway.”"},{"ref":"wa2:coda:3014_2:12","line":12,"speakerJa":"かずさ","speakerEn":"Kazusa","japanese":"「わかってる。\nじゃあ…行ってくる」","english":"“I know. Well… I’m off.”"},{"ref":"wa2:coda:3014_2:13","line":13,"speakerJa":"曜子","speakerEn":"Youko","japanese":"「………なるべくなら客席は見ないようにね」","english":"“………If you can, try not to look at the audience.”"},{"ref":"wa2:coda:3014_2:14","line":14,"speakerJa":"","speakerEn":"","japanese":"………","english":"………"},{"ref":"wa2:coda:3014_2:15","line":15,"speakerJa":"","speakerEn":"","japanese":"……","english":"……"},{"ref":"wa2:coda:3014_2:16","line":16,"speakerJa":"","speakerEn":"","japanese":"…","english":"…"}]}
