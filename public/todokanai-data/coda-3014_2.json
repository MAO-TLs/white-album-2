{"schema":"wa2-todokanai-comparison/1","route":"coda","routeLabel":"Coda","scriptId":"3014_2","lineCount":16,"availableCount":16,"lines":[{"ref":"wa2:coda:3014_2:1","english":"\"Kazusa… it's time.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:2","english":"\"Mhm…\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:3","english":"\"How are you? Are you nervous?\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:4","english":"\"As if. I'm just like I always am.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:5","english":"\"I see…\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:6","english":"\"…No, I'm a bit different. I can't even imagine failing now.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:7","english":"\"………\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:8","english":"\"I might even surpass you today.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:9","english":"\"I would welcome such a performance with open arms.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:10","english":"\"…Just joking of course, but I am composed enough to do that.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:11","english":"\"Then keep up that pace until the very end. Don't get caught up by idle thoughts halfway through.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:12","english":"\"I know that. Well then… I'm going.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:13","english":"\"…If possible, I hope you avoid looking at the audience seats.\"","status":"mapped_high"},{"ref":"wa2:coda:3014_2:14","english":"………","status":"mapped_high"},{"ref":"wa2:coda:3014_2:15","english":"……","status":"mapped_high"},{"ref":"wa2:coda:3014_2:16","english":"…","status":"mapped_high"}]}
